{
  "name": "agentrouter",
  "env": {
    "ANTHROPIC_BASE_URL": "https://agentrouter.org",
    "NO_PROXY": "localhost,127.0.0.1,::1"
  },
  "resolveModels": {
    "from": "https://agentrouter.org/api/pricing",
    "idField": "model_name",
    "ratioField": "model_ratio",
    "requiresEndpointType": "anthropic",
    "assignment": "family"
  },
  "contextSuffixes": {
    "deepseek-v4-flash": "[1m]"
  }
}
