{
  "name": "deepseek",
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
    "NO_PROXY": "localhost,127.0.0.1,::1,api.deepseek.com,.deepseek.com"
  },
  "resolveModels": {
    "from": "https://api.deepseek.com/models",
    "idField": "id",
    "contextWindowField": "context_window",
    "assignment": "single",
    "prefer": "^deepseek-flash$"
  },
  "opencode": {
    "baseURL": "https://api.deepseek.com/v1"
  }
}
