{
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
    "ANTHROPIC_MODEL": "deepseek-v4-flash[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "deepseek-v4-flash[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "deepseek-v4-flash",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek-v4-pro[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-v4-flash[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "deepseek-v4-flash",
    "CLAUDE_CODE_SUBAGENT_MODEL": "deepseek-v4-flash",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_EFFORT_LEVEL": "max"
  },
  "model": "deepseek-v4-flash[1m]",
  "statusLine": {
    "type": "command",
    "command": "\"C:/Program Files/Git/bin/bash.exe\" -lc \"$HOME/.claude/statusline.sh\"",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "frontend-skills@cc-frontend-skills": false,
    "superpowers@claude-plugins-official": false,
    "ponytail@ponytail": true,
    "context7@claude-plugins-official": false,
    "impeccable@impeccable": false,
    "diagram-design@diagram-design": true
  },
  "extraKnownMarketplaces": {
    "cc-frontend-skills": {
      "source": {
        "source": "github",
        "repo": "oikon48/cc-frontend-skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  },
  "effortLevel": "xhigh",
  "theme": "dark-ansi",
  "autoCompactEnabled": true,
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/no-destructive-git.sh", "timeout": 5}]},
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/no-git-amend.sh", "timeout": 5}]},
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/no-dangerous-ops.sh", "timeout": 5}]},
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/no-cat-write.sh", "timeout": 5}]},
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/no-heredoc.sh", "timeout": 5}]},
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/no-devnull-redirect.sh", "timeout": 5}]},
      {"matcher": "AskUserQuestion", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/no-multi-question.sh", "timeout": 5}]},
      {"matcher": "WebFetch", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/hint-skill-read-url.sh", "timeout": 5}]},
      {"matcher": "Write|Edit|MultiEdit", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/hint-agent-claude-code-guide.sh", "timeout": 5}]}
    ],
    "PostToolUse": [
      {"matcher": "Agent", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/verify-explore-results.sh", "timeout": 5}]},
      {"matcher": "WebSearch", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/websearch-followup-hint.sh", "timeout": 5}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "bash ~/.claude/hooks/inject-git-status.sh", "timeout": 5}]},
      {"hooks": [{"type": "command", "command": "bash ~/.claude/hooks/inject-time.sh", "timeout": 5}]}
    ]
  }
}
